    <string name="integrity_reset">Reset baselines</string>
    <string name="integrity_reset_done">Baselines cleared, learning again</string>
    <string name="integrity_disclaimer">These are heuristics, not proof. Moving indoors, under trees or into a vehicle also weakens signals; each check explains what it looks at. Reset the baselines after a big change of environment. AGC (the strongest jamming indicator) is only available on devices that report raw GNSS measurements.</string>
    <string name="measurements_not_supported">This device does not provide raw GNSS measurements, so AGC is unavailable and jamming can only be flagged as possible.</string>

    <string name="check_agc">AGC noise floor</string>
    <string name="check_agc_desc">Receiver gain per band. A jammer adds in-band power, so the gain drops well below its baseline.</string>
    <string name="check_cn0_drop">Signal strength drop</string>
    <string name="check_cn0_drop_desc">Average of the 4 strongest signals against its baseline. All satellites fading together points to interference or an obstruction.</string>
    <string name="check_signal_loss">Signals lost</string>
    <string name="check_signal_loss_desc">Number of tracked signals against the usual count.</string>
    <string name="check_mock">Mock location</string>
    <string name="check_mock_desc">Android reports that the position comes from a mock provider (fake GPS app or developer option).</string>
    <string name="check_network">GNSS vs network position</string>
    <string name="check_network_desc">Distance between the GNSS fix and the Wi-Fi/cell position. A spoofed fix drifts away from where the networks place you.</string>
    <string name="check_jump">Position jumps</string>
    <string name="check_jump_desc">Fix moving faster than physically plausible (over 150 m/s and 300 m), typical when a spoofer takes over.</string>
    <string name="check_clock">GNSS time</string>
    <string name="check_clock_desc">GNSS time against the phone clock (set by the network), and sudden time jumps between fixes.</string>
    <string name="check_uniform">Signal uniformity</string>
    <string name="check_uniform_desc">Spread of C/N0 across satellites. Signals from one transmitter arrive with nearly identical strength; real ones vary.</string>
    <string name="check_elevation">Strength vs elevation</string>
    <string name="check_elevation_desc">Real satellites are usually stronger higher in the sky (positive correlation). A spoofer cannot reproduce that.</string>
    <string name="check_strong">Unusually strong signals</string>
    <string name="check_strong_desc">Phones rarely see several signals above 50 dB-Hz from space.</string>
    <string name="check_constellations">Constellations</string>
    <string name="check_constellations_desc">Simple spoofers only transmit GPS L1, so the other systems disappear.</string>

