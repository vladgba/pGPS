<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- pGPS roles, aliased to the shared pUI tokens (light/dark handled by the tokens).
         Data-series colors (constellations, charts) stay in code: they encode meaning. -->
    <color name="bg">@color/p_bg</color>
    <color name="surface">@color/p_surface</color>
    <color name="surface_variant">@color/p_surface2</color>
    <color name="divider">@color/p_line</color>
    <color name="text_primary">@color/p_text</color>
    <color name="text_secondary">@color/p_text2</color>
    <color name="accent">@color/p_accent_text</color>
    <color name="accent_soft">@color/p_accent_soft</color>
    <color name="on_accent_soft">@color/p_on_accent_soft</color>

    <color name="state_good">@color/p_success</color>
    <color name="state_warn">@color/p_warning</color>
    <color name="state_bad">@color/p_danger</color>
    <color name="state_off">@color/p_text3</color>

    <!-- Mock-location / permission banner: warning tint over the page color. -->
    <color name="banner_bg">#33F59E0B</color>
</resources>
