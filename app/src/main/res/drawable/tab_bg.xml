<?xml version="1.0" encoding="utf-8"?>
<!-- Tab background: accent underline when selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <color android:color="@color/surface" />
            </item>
            <item android:gravity="bottom" android:height="3dp">
                <color android:color="@color/accent" />
            </item>
        </layer-list>
    </item>
    <item>
        <color android:color="@color/surface" />
    </item>
</selector>
